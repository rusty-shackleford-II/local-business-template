# Cloudflare Pages Headers Configuration
# This file automatically applies headers to your deployed sites
# Reference: https://developers.cloudflare.com/pages/configuration/headers/

# Cache all images aggressively
# NOTE: X-Robots-Tag is intentionally NOT set on image wildcards.
# robots.txt already blocks image crawling for bandwidth protection.
# Adding X-Robots-Tag here would also apply to favicons and OG images
# (Cloudflare merges headers from all matching rules), which breaks
# Google search results favicon display and social sharing previews.
/*.jpg
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/*.jpeg
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/*.png
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/*.webp
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/*.gif
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/*.svg
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# Favicons and OG images - shorter cache for easier updates
/favicon.png
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400

/favicon.ico
  Cache-Control: public, max-age=86400

/og-image.png
  Cache-Control: public, max-age=86400

/og-image.jpg
  Cache-Control: public, max-age=86400

# Static assets (fonts, etc)
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# HTML pages - normal caching
/*.html
  Cache-Control: public, max-age=3600
  Content-Type: text/html; charset=utf-8
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin

# Default for all other files
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin

